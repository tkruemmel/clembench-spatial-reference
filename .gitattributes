# Grid-rendered campaign results: episode trees are large and binary-ish for
# git's purposes (tens of thousands of small JSON files). Store them in LFS.
results_*_grid_n15_*/** filter=lfs diff=lfs merge=lfs -text
# Updated-prompt arms of the same campaigns (cooperative suites only).
results_*_grid_updated_prompt_n15_*/** filter=lfs diff=lfs merge=lfs -text
# Crossed-device S3x/S4x arm (DeepSeek dyad and 6p).
results_*_grid_crossed_n15_*/** filter=lfs diff=lfs merge=lfs -text
# Final arm (solo, dyad) and its 3p/6p run with messages in the order sent.
results_*_grid_final_n15_*/** filter=lfs diff=lfs merge=lfs -text
results_*_grid_final_chrono_n15_*/** filter=lfs diff=lfs merge=lfs -text
