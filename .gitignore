!humanweb_api.py

# cached images
mapworld/escapegame/resources/images

# ipynb checkpoints
.ipynb_checkpoints

# manually configure logging
logging.yaml

/thesis/
.superpowers/

# sdd worktrees
.worktrees/
campaign/.potsdam_rate_cache_*.json

# campaign runner shard files (cut from in/instances*.json on every pass; transient)
matrixgame_covered_*/in/instances_*_w[0-9]*.json
matrixgame_covered_*/in/instances_resume_*.json

# qualitative-analysis corpus cache (regenerate with qual_corpus.py --refresh)
analysis/qualitative_analysis/corpus.json
analysis/qualitative_analysis/episodes.json

# campaign runner scratch inside results trees (worker state, stop sentinels)
results_*/_campaign/

# Analysis caches, one per arm; rebuilt by scan.py, idle.py, forced.py and
# qual_corpus.py --refresh (and the f5/f6 step scripts).
analysis/**/*.original.json
analysis/**/*.updated.json
analysis/**/*.original.jsonl
analysis/**/*.updated.jsonl
analysis/**/*.original.pkl
analysis/**/*.updated.pkl
